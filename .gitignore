# Created on each PC by the installer and the app. Never commit these.
/runtime/
/outputs/
/inputs/
/logs/

# Model weights are downloaded by Install.cmd. Only the story writer's small
# Ollama package files (manifest, licence, parameters) are kept in the repository.
/models/*
!/models/story-writer/
/models/story-writer/*
!/models/story-writer/LICENSE.txt
!/models/story-writer/ollama/
/models/story-writer/ollama/blobs/sha256-dec52a44569a2a25341c4e4d3fee25846eed4f6f0b936278e3a3c900bb99d37c
*.part
*.download-state.json
*.lock
*.log
*.tmp

# Backups and reference photos must never be published.
/app-backup-*/
/references/
